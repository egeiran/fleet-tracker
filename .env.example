# --- BarentsWatch AIS (https://www.barentswatch.no -> Min side -> API-klienter, huk av AIS) ---
# Uten disse kjører ingest med Entur (tog) + mock for sjø og vei.
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=

# --- Entur (ingen nøkkel, kun identifiserende klientnavn) ---
ENTUR_CLIENT_NAME=vakt-fleetmap

# --- Ingest-worker ---
PORT=8080
DB_PATH=./data/ingest.sqlite
CORS_ORIGINS=http://localhost:3000
FLEET_SEA=30
FLEET_RAIL=15
FLEET_ROAD=15
LOG_LEVEL=info

# --- Web ---
NEXT_PUBLIC_INGEST_URL=http://localhost:8080
